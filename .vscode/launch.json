{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "client: chrome",
            "url": "http://localhost:8081",
            "webRoot": "${workspaceFolder}/app"
        },
        {
            "type": "firefox",
            "name": "client: firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://localhost:8081",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://localhost:8081/_nuxt/pages",
                    "path": "${workspaceFolder}/app/pages"
                },
                {
                    "url": "http://localhost:8081/_nuxt/pages/index.vue",
                    "path": "${workspaceFolder}/app/pages/entrar/index.vue"
                }
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "server: nuxt",
            "outputCapture": "std",
            "program": "${workspaceFolder}/node_modules/nuxt/bin/nuxt.mjs",
            "args": [
                "dev",
                "-- --host --port 8081"
            ]
        }
    ],
    "compounds": [
        {
            "name": "fullstack: nuxt + chrome",
            "configurations": [
                "server: nuxt",
                "client: chrome"
            ]
        },
        {
            "name": "fullstack: nuxt + firefox",
            "configurations": [
                "server: nuxt",
                "client: firefox"
            ]
        }
    ]
}